# ==========================================
# RemoteCommander Web Agent Configuration
# ==========================================

# Port (Handled automatically by cPanel Passenger, default 3000)
PORT=3000

# Access Password (protects the web console)
ADMIN_PASSWORD=change_this_master_password

# JWT Session Encryption Secret
JWT_SECRET=generate_a_random_secret_string_here

# cPanel & WHM Gateway (Loopback connection on port 2087)
WHM_HOST=127.0.0.1
WHM_PORT=2087
WHM_API_TOKEN=your_whm_api_token_here

# AI Operations Assistant (OpenAI gpt-5-mini)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Website Root Directory (All file manager ops are scoped to this directory)
WEBSITE_ROOT=/home/username/public_html
DATA_DIR=./data
