{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteCommander",
  "version": "1.0.0",
  "identifier": "com.remotecommander.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteCommander",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' http://localhost:* https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Secure Desktop AI Operations Assistant",
    "longDescription": "A private, auditable, and policy-governed desktop application for server administration and AI-driven infrastructure operations.",
    "copyright": "Copyright © 2026 RemoteCommander Contributors. MIT License.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["en-US"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": []
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFJlbW90ZUNvbW1hbmRlciBSZWxlYXNlIFNpZ25pbmcgS2V5ClJXVFd5aDhhR3V1NmdBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=",
      "endpoints": ["https://releases.remotecommander.com/updates/{{target}}/{{current_version}}"]
    }
  }
}
